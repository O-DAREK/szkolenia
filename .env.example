# Endpoint formularza kontaktowego (Formspree).
# 1. Załóż formularz na https://formspree.io i skopiuj jego adres.
# 2. Skopiuj ten plik jako .env.local i wstaw swój identyfikator.
# Bez tej zmiennej formularz działa w trybie awaryjnym (otwiera klienta poczty).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/twoj-id
